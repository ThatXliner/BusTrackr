# Copy to .env.server. Keep mailbox credentials OUT of VITE_* variables.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
# Gmail APP password, not the ordinary Google account password.
IMAP_PASSWORD=
# OAuth alternatives: short-lived token, or automatic refresh with these 3 fields.
IMAP_ACCESS_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=30
# Import existing camera emails on first connection; 0 starts with future mail only.
IMAP_BACKFILL_DAYS=7
CAMERA_SENDER=Avigilonalerts@vcs.net
# Optional until actual subject is confirmed. Sender + timestamped body are always required.
CAMERA_SUBJECT=
CAMERA_MARKER=BEI Bus has arrived.
CAMERA_CHECKPOINT=BEI campus corner
# Group nearby notifications for estimates; preserve every distinct email in history.
CAMERA_COOLDOWN_SECONDS=30
ALERT_HOST=127.0.0.1
ALERT_PORT=8787
ALERT_STATE_FILE=.data/alerts.json
ALERT_SCHEDULE_FILE=server/schedule.json
ALERT_ALLOWED_ORIGIN=
