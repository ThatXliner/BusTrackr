{
  "name": "valley-shuttle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/check-road-profiles.mjs && node scripts/check-local-scene.mjs && tsx scripts/check-road-contact.ts && tsx scripts/check-building-surfaces.ts && tsc -b && vite build",
    "build:corridor": "node scripts/build-corridor.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "build:local-footprints": "python3 scripts/build-local-footprints.py",
    "fetch:local-aerial": "python3 scripts/fetch-local-aerial.py && python3 scripts/fetch-local-aerial.py --campus"
  },
  "dependencies": {
    "@turf/buffer": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^7.1.0"
  }
}
